// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Portfolio persistence layer
// ---------------------------------------------------------------------------

/// Page views counter — survives server restarts (replaces the in-memory map).
model ProjectView {
  slug    String @id
  views   Int    @default(0)
  updatedAt DateTime @updatedAt
}

/// Per-view event log for real time-series analytics (one row per view).
model ViewEvent {
  id        String   @id @default(cuid())
  slug      String   // project slug
  createdAt DateTime @default(now())

  @@index([slug])
  @@index([createdAt])
}

/// Visitor tracking — captures country + device for each unique session.
/// IP is hashed (not stored raw) for privacy. Country is resolved
/// server-side from the X-Forwarded-For IP via a free IP geolocation API.
/// Device type / browser / OS are parsed from the User-Agent header.
model Visitor {
  id           String   @id @default(cuid())
  // SHA-256 of the IP + a daily salt. Lets us dedupe per day per IP without
  // ever storing the raw IP.
  ipHash       String   @unique
  country      String   @default("Unknown") // ISO 3166-1 alpha-2 code, e.g. "PY", "AR", "US"
  countryName  String   @default("Unknown") // human-readable, e.g. "Paraguay"
  city         String   @default("Unknown")
  region       String   @default("Unknown")
  // Parsed from User-Agent at request time.
  deviceType   String   @default("Unknown") // mobile | tablet | desktop | bot
  os           String   @default("Unknown") // e.g. "Windows", "macOS", "Android", "iOS"
  browser      String   @default("Unknown") // e.g. "Chrome", "Safari", "Firefox"
  // Aggregate counters — updated on each visit.
  visits       Int      @default(1)
  lastSeenAt   DateTime @default(now())
  firstSeenAt  DateTime @default(now())
  // Per-day counter so the admin can show "visits in last 24h" / "last 7 days".
  // Updated by incrementing visits + resetting lastSeenAt on each new visit.
  createdAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([country])
  @@index([deviceType])
  @@index([lastSeenAt])
}

/// Contact messages submitted through the contact form.
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  ticket    String   @unique
  createdAt DateTime @default(now())
}

/// Newsletter subscribers.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

/// Blog/devlog posts shown in the Updates section. Seeded from content.ts.
model Update {
  slug      String   @id
  title     String
  excerpt   String
  body      String   // newline-separated paragraphs
  date      DateTime
  category  String   // release | devlog | case-study | announcement
  tags      String   // comma-separated
  project   String?
  readTime  Int      @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Testimonials shown in the carousel. Seeded from content.ts.
model Testimonial {
  id             String   @id @default(cuid())
  name           String
  role           String
  company        String
  quote          String
  rating         Int      @default(5)
  avatarInitials String
  accent         String
  project        String?
  createdAt      DateTime @default(now())
}

/// Dynamic projects (so new apps can be added from the admin without code).
/// Seeded from projects.ts on first read. After that the DB is the source of truth.
model ProjectRow {
  slug          String   @id
  name          String
  tagline       String
  category      String
  status        String   // live | beta | maintenance
  year          String
  url           String
  accent        String
  icon          String
  screenshot    String
  summary       String
  description   String
  longDescription String
  features      String   // JSON string of [{title,description}]
  metrics       String   // JSON string of [{label,value}]
  techStack     String   // JSON string of [{name,category}]
  highlights    String   // JSON string of string[]
  audience      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Keep legacy models for backwards compatibility with the scaffold.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
